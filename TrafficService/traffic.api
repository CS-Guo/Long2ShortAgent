syntax = "v1"

type TrafficSummaryRequest {
	ShortCode string `path:"shortCode"`
	From string `form:"from"`
	To string `form:"to"`
}

type ReferrerStat {
	Referrer string `json:"referrer"`
	Pv int64 `json:"pv"`
}

type DailyStat {
	Date string `json:"date"`
	Pv int64 `json:"pv"`
	Uv int64 `json:"uv"`
}

type TrafficSummaryResponse {
	ShortCode string `json:"shortCode"`
	From string `json:"from"`
	To string `json:"to"`
	Pv int64 `json:"pv"`
	Uv int64 `json:"uv"`
	TopReferrers []ReferrerStat `json:"topReferrers"`
	Trend []DailyStat `json:"trend"`
}

service traffic-service {
	@handler GetTrafficSummaryHandler
	get /internal/traffic/shortlinks/:shortCode/summary (TrafficSummaryRequest) returns (TrafficSummaryResponse)
}

